Package: jcglasso
Type: Package
Title: Joint Conditional Graphical Lasso with Censored and Missing Values
Version: 1.0.0
Authors@R: c(
    person("Gianluca", "Sottile", email = "gianluca.sottile@unipa.it",
           role = c("aut", "cre"), comment = c(ORCID = "0000-0001-9347-7251")),
